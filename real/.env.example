# 이 파일을 .env로 복사해 값을 채운다.  cp .env.example .env
# 상위 폴더(모노레포 루트)의 .env도 자동으로 찾는다.

# 판단(LLM) — 기본 모델 gpt-5.6-terra에 필수.  https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Claude 모델로 바꿔 비교할 때만 필요.  https://console.anthropic.com
ANTHROPIC_API_KEY=

# 예: Claude를 쓸 때 아래 두 모델명도 함께 바꾼다.
# LIBCOPILOT_MODEL_FIT=claude-opus-4-8
# LIBCOPILOT_MODEL_KEYWORD=claude-opus-4-8

# 책소개 — 선택(없어도 파이프라인은 돈다. 책소개 없이 판단할 뿐).
# 알라딘 → 오픈API → TTB 인증키 발급 (무료).  http://www.aladin.co.kr/ttb/wblog_manage.aspx
ALADIN_TTB_KEY=

# 2단계(082+종합서지)까지로 이미 수렴이면 키워드를 안 돈다. 기본 on — 끄면 항상 3단계까지.
# LIBCOPILOT_STAGE2_GATE=on
# 자르는 선 두 개(점수·격차). 기본 0.80 / 0.15.
# LIBCOPILOT_THRESHOLD_2=0.80
# LIBCOPILOT_GAP_MIN=0.15

# ── 아래는 현재 코드에서 쓰지 않는다 ──
# 국립중앙도서관 Open API. 12권 실측 결과 목차·책소개 커버리지가 낮아 알라딘으로 대체했다.
# (docs/design.md §4.1) 다시 시도할 때를 위해 자리만 남긴다.  https://www.nl.go.kr/NL/contents/N31101030700.do
# NL_API_KEY=
